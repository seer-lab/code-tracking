      <aliases enabled='yes' />
      <column caption='Action Group (Write/Copy)' datatype='string' name='[Calculation_0820824279863296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [action] IN (&#13;&#10;    &quot;Edit&quot;,&#13;&#10;    &quot;EditorStartNewLine&quot;,&#13;&#10;    &quot;EditorIndentSelection&quot;,&#13;&#10;    &quot;EditorUnindentSelection&quot;,&#13;&#10;    &quot;EditorDeleteToWordStart&quot;,&#13;&#10;    &quot;Replace text&quot;,&#13;&#10;    &quot;Backspace&quot;,&#13;&#10;    &quot;Delete&quot;,&#13;&#10;    &quot;Enter&quot;,&#13;&#10;    &quot;Undo&quot;&#13;&#10;) THEN &quot;Writing&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Paste&quot;,&#13;&#10;    &quot;Paste (external)&quot;,&#13;&#10;    &quot;Copy/Paste (internal)&quot;,&#13;&#10;    &quot;Cut&quot;,&#13;&#10;    &quot;Accept Inline Completion&quot;,&#13;&#10;    &quot;Choose Autocomplete&quot;,&#13;&#10;    &quot;EditorChooseLookupItem&quot;&#13;&#10;) THEN &quot;Copy / Paste&quot;&#13;&#10;END' />
      </column>
      <column caption='Characters Written' datatype='integer' name='[Calculation_1785647319437312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2092682916044800] = &apos;Writing&apos; THEN [change_len] ELSE 0 END' />
      </column>
      <column caption='Characters Copied/Pasted' datatype='integer' name='[Calculation_1785647319760897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2092682916044800] = &apos;Copy / Paste&apos; THEN [change_len] ELSE 0 END' />
      </column>
      <column caption='Action Group' datatype='string' name='[Calculation_2092682916044800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [action] IN (&#13;&#10;    &quot;Edit&quot;,&#13;&#10;    &quot;EditorStartNewLine&quot;,&#13;&#10;    &quot;EditorIndentSelection&quot;,&#13;&#10;    &quot;EditorUnindentSelection&quot;,&#13;&#10;    &quot;EditorDeleteToWordStart&quot;,&#13;&#10;    &quot;Replace text&quot;,&#13;&#10;    &quot;Backspace&quot;,&#13;&#10;    &quot;Delete&quot;,&#13;&#10;    &quot;Enter&quot;,&#13;&#10;    &quot;Undo&quot;&#13;&#10;) THEN &quot;Writing&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Paste&quot;,&#13;&#10;    &quot;Paste (external)&quot;,&#13;&#10;    &quot;Copy/Paste (internal)&quot;,&#13;&#10;    &quot;Cut&quot;,&#13;&#10;) THEN &quot;Copy / Paste&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Left Arrow&quot;,&#13;&#10;    &quot;Right Arrow&quot;,&#13;&#10;    &quot;Up Arrow&quot;,&#13;&#10;    &quot;Down Arrow&quot;,&#13;&#10;    &quot;Tab&quot;&#13;&#10;) THEN &quot;Navigation&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Accept Inline Completion&quot;,&#13;&#10;    &quot;Choose Autocomplete&quot;,&#13;&#10;    &quot;Choose Autocomplete Item&quot;,&#13;&#10;    &quot;EditorChooseLookupItem&quot;,&#13;&#10;    &quot;EditorChooseLookupItemReplace&quot;,&#13;&#10;    &quot;EditorIndentSelection&quot;&#13;&#10;) THEN &quot;Autocomplete&quot;&#13;&#10;&#13;&#10;ELSEIF [action] = &quot;Inactivity&quot; THEN &quot;Inactivity&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Duration (Visible)' datatype='real' name='[Calculation_2092682916265985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2092682916343810] &lt; 0.25 THEN 0.25&#13;&#10;ELSE [Calculation_2092682916343810]&#13;&#10;END' />
      </column>
      <column caption='Duration (Minutes)' datatype='real' name='[Calculation_2092682916343810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2092682916409347]/60' />
      </column>
      <column caption='Duration' datatype='real' name='[Calculation_2092682916409347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[end_sec] - [start_sec]' />
      </column>
      <column caption='Start Min (Normalized)' datatype='real' name='[Calculation_2092682916769796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[start_min] - { FIXED [Sheet] : MIN([start_min]) }' />
      </column>
