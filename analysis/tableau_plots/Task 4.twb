    <worksheet name='Task 1 Write vs. Copy/Paste'>
      <table>
        <view>
          <datasources>
            <datasource caption='student1' name='federated.1siv0bj094mggt1d28q131sbn5ys' />
          </datasources>
          <datasource-dependencies datasource='federated.1siv0bj094mggt1d28q131sbn5ys'>
            <column caption='Action Group' datatype='string' name='[Calculation_0953307264577536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [action] IN (&#13;&#10;    &quot;Edit&quot;,&#13;&#10;    &quot;EditorStartNewLine&quot;,&#13;&#10;    &quot;EditorIndentSelection&quot;,&#13;&#10;    &quot;EditorUnindentSelection&quot;,&#13;&#10;    &quot;EditorDeleteToWordStart&quot;,&#13;&#10;    &quot;Replace text&quot;,&#13;&#10;    &quot;Backspace&quot;,&#13;&#10;    &quot;Delete&quot;&#13;&#10;) THEN &quot;Writing&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Paste&quot;,&#13;&#10;    &quot;Paste (external)&quot;,&#13;&#10;    &quot;Copy/Paste (internal)&quot;,&#13;&#10;    &quot;Cut&quot;&#13;&#10;) THEN &quot;Copy / Paste&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Left Arrow&quot;,&#13;&#10;    &quot;Right Arrow&quot;,&#13;&#10;    &quot;Up Arrow&quot;,&#13;&#10;    &quot;Down Arrow&quot;,&#13;&#10;    &quot;Tab&quot;&#13;&#10;) THEN &quot;Navigation&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Accept Inline Completion&quot;,&#13;&#10;    &quot;Choose Autocomplete&quot;,&#13;&#10;    &quot;EditorChooseLookupItem&quot;&#13;&#10;) THEN &quot;Autocomplete&quot;&#13;&#10;&#13;&#10;ELSEIF [action] = &quot;Inactivity&quot; THEN &quot;Inactivity&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Student' datatype='string' name='[Calculation_0953307264651265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Table Name], &quot;.csv&quot;, 1)' />
            </column>
            <column caption='Duration' datatype='real' name='[Calculation_0953307264704514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[end_sec] - [start_sec]' />
            </column>
            <column caption='Duration (Minutes)' datatype='real' name='[Calculation_0953307264761859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0953307264704514]/60' />
            </column>
            <column datatype='string' name='[Table Name]' role='dimension' type='nominal' />
            <column caption='Action' datatype='string' name='[action]' role='dimension' type='nominal' />
            <column caption='End Sec' datatype='string' default-role='measure' default-type='ordinal' name='[end_sec]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0953307264577536]' derivation='None' name='[none:Calculation_0953307264577536:nk]' pivot='key' type='nominal' />
