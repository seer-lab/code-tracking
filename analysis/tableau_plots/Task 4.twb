          <datasource-dependencies datasource='federated.14mi3u81ivbh0c1chdmfa03ooq30'>
            <column caption='Action Group' datatype='string' name='[Calculation_0688324964728832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [action] IN (&#13;&#10;    &quot;Edit&quot;,&#13;&#10;    &quot;EditorStartNewLine&quot;,&#13;&#10;    &quot;EditorIndentSelection&quot;,&#13;&#10;    &quot;EditorUnindentSelection&quot;,&#13;&#10;    &quot;EditorDeleteToWordStart&quot;,&#13;&#10;    &quot;Replace text&quot;,&#13;&#10;    &quot;Backspace&quot;,&#13;&#10;    &quot;Delete&quot;&#13;&#10;) THEN &quot;Editing&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Paste&quot;,&#13;&#10;    &quot;Paste (external)&quot;,&#13;&#10;    &quot;Copy/Paste (internal)&quot;,&#13;&#10;    &quot;Cut&quot;&#13;&#10;) THEN &quot;Cut / Paste&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Left Arrow&quot;,&#13;&#10;    &quot;Right Arrow&quot;,&#13;&#10;    &quot;Up Arrow&quot;,&#13;&#10;    &quot;Down Arrow&quot;,&#13;&#10;    &quot;Tab&quot;&#13;&#10;) THEN &quot;Navigation&quot;&#13;&#10;&#13;&#10;ELSEIF [action] IN (&#13;&#10;    &quot;Accept Inline Completion&quot;,&#13;&#10;    &quot;Choose Autocomplete&quot;,&#13;&#10;    &quot;EditorChooseLookupItem&quot;&#13;&#10;) THEN &quot;Autocomplete&quot;&#13;&#10;&#13;&#10;ELSEIF [action] = &quot;Inactivity&quot; THEN &quot;Inactivity&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Student' datatype='string' name='[Calculation_0688324964786177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Table Name], &quot;.csv&quot;, 1)' />
            </column>
            <column caption='Duration' datatype='real' name='[Calculation_0688324965257220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[end_sec] - [start_sec]' />
            </column>
            <column caption='Duration (Minutes)' datatype='real' name='[Calculation_0688324965330949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0688324965257220]/60' />
            </column>
            <column caption='Duration (Visible)' datatype='real' name='[Calculation_0688324965367814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0688324965330949] &lt; 0.1 THEN 0.1&#13;&#10;ELSE [Calculation_0688324965330949]&#13;&#10;END' />
            </column>
            <column caption='Student Start Min' datatype='real' datatype-customized='true' name='[Calculation_0688324965441543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT({ FIXED [Calculation_0688324964786177] : MIN([start_min]) })' />
            </column>
            <column caption='Start Min (Normalized)' datatype='real' name='[Calculation_0688324965621768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[start_min] - [Calculation_0688324965441543]' />
            </column>
            <column datatype='string' name='[Table Name]' role='dimension' type='nominal' />
            <column caption='Action' datatype='string' name='[action]' role='dimension' type='nominal' />
            <column caption='End Sec' datatype='real' name='[end_sec]' role='measure' type='quantitative' />
