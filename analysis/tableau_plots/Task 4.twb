          <datasource-dependencies datasource='federated.1siv0bj094mggt1d28q131sbn5ys'>
            <column caption='Student' datatype='string' name='[Calculation_0953307264651265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Table Name], &quot;.csv&quot;, 1)' />
            </column>
            <column caption='Start Min (Normalized)' datatype='real' name='[Calculation_0953307264978949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[start_min] - [Calculation_0953307265048582]' />
            </column>
            <column caption='Student Start Min' datatype='real' name='[Calculation_0953307265048582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_0953307264651265] : MIN([start_min]) }' />
            </column>
            <column caption='Code Size' datatype='integer' name='[Calculation_0979420808294400]' role='measure' type='quantitative'>
