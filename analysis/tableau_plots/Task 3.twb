      <column caption='Duration' datatype='real' name='[Calculation_2092682916409347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[end_sec] - [start_sec]' />
      </column>
      <column caption='Start Min (Normalized)' datatype='real' name='[Calculation_2092682916769796]' role='measure' type='quantitative'>
