  <worksheets>
    <worksheet name='Task 3 Code Size'>
      <table>
        <view>
          <datasources>
            <datasource caption='student1' name='federated.1siv0bj094mggt1d28q131sbn5ys' />
          </datasources>
          <datasource-dependencies datasource='federated.1siv0bj094mggt1d28q131sbn5ys'>
            <column caption='Student' datatype='string' name='[Calculation_0953307264651265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Table Name], &quot;.csv&quot;, 1)' />
            </column>
            <column caption='Start Min (Normalized)' datatype='real' name='[Calculation_0953307264978949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[start_min] - [Calculation_0953307265048582]' />
            </column>
            <column caption='Student Start Min' datatype='real' name='[Calculation_0953307265048582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_0953307264651265] : MIN([start_min]) }' />
            </column>
            <column caption='Code Size' datatype='integer' name='[Calculation_0979420808294400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LEN([content]) + 1' />
            </column>
            <column caption='Time % (Per Student)' datatype='real' name='[Calculation_1912082804133888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX() / WINDOW_MAX(INDEX())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Code Size (Normalized)' datatype='real' name='[Calculation_1912082805121025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0979420808294400]) / WINDOW_MAX(SUM([Calculation_0979420808294400]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Table Name]' role='dimension' type='nominal' />
            <column caption='Content' datatype='string' name='[content]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0953307264651265]' derivation='None' name='[none:Calculation_0953307264651265:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0979420808294400]' derivation='None' name='[none:Calculation_0979420808294400:qk]' pivot='key' type='quantitative' />
            <column aggregation='Count' caption='Start Min' datatype='real' datatype-customized='true' name='[start_min]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0953307264978949]' derivation='Sum' name='[sum:Calculation_0953307264978949:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1912082804133888]' derivation='User' name='[usr:Calculation_1912082804133888:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_1912082805121025]' derivation='User' name='[usr:Calculation_1912082805121025:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1siv0bj094mggt1d28q131sbn5ys].[none:Calculation_0979420808294400:qk]' included-values='non-null' />
          <slices>
            <column>[federated.1siv0bj094mggt1d28q131sbn5ys].[none:Calculation_0979420808294400:qk]</column>
          </slices>
          <aggregation value='false' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1siv0bj094mggt1d28q131sbn5ys].[usr:Calculation_1912082805121025:qk]' scope='rows' value='Code Size (Percentage)' />
            <format attr='title' class='0' field='[federated.1siv0bj094mggt1d28q131sbn5ys].[usr:Calculation_1912082804133888:qk:1]' scope='cols' value='Time (Percentage)' />
